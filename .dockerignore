# Lo que el build genera, o no necesita para generarse. node_modules sobre todo: el de la laptop es
# de Windows, y el de la imagen sale de su propio npm ci.
.git
.github
.claude
node_modules
dist
coverage
Dockerfile

# El gate corre adentro del build, así que entra todo lo que leen los tests: el design.json (H5) y
# este mismo archivo (H14). De .impeccable queda afuera el resto, sobre todo las capturas.
.impeccable/*
!.impeccable/design.json
